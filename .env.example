# Скопіюйте в .env і змініть за потреби
LOG_LEVEL=INFO
LOG_FORMAT=json            # json | text

BOOKS_BASE_URL=https://books.toscrape.com/
QUOTES_JS_URL=https://quotes.toscrape.com/js/

MAX_PAGES=15               # загальний ліміт сторінок книжок за прогін (list + detail)
LIST_PAGES=1               # скільки сторінок каталогу обходити
JS_PAGES=2                 # скільки JS-сторінок цитат обходити
REQUEST_DELAY_MS=500       # пауза між запитами (не менше 200)
PAGE_TIMEOUT_MS=30000

# Scheduler (advanced)
BOOKS_INTERVAL_SECONDS=1800
QUOTES_INTERVAL_SECONDS=3600

GRAFANA_PASSWORD=admin
